# S8: re_replace core behavior.

import regex

define check(label, got, want) as:
    if got == want:
        print of (label + " OK")
    else:
        print of (label + " FAIL")
        print of "  got:"
        print of got
        print of "  want:"
        print of want
    return 0

# ---- re_replace core behavior ----
prog is regex.re_compile of "[0-9]+"
check of ["re_replace basic", regex.re_replace of [prog, "a1 b22 c", "#"], "a# b# c"]
check of ["re_replace no match", regex.re_replace of [prog, "abc", "#"], "abc"]
check of ["re_replace whole string", regex.re_replace of [prog, "123", "#"], "#"]
prog is regex.re_compile of "x*"
check of ["re_replace zero-width passes chars through", regex.re_replace of [prog, "abc", "-"], "-a-b-c-"]
check of ["re_replace null prog returns input", regex.re_replace of [null, "abc", "-"], "abc"]
