import regex
failures is 0
define sample(p, s) as:
    local t0 is monotonic_ms of null
    for k in range of 8:
        regex.re_search of [p, s]
    return (monotonic_ms of null) - t0
define timed(pat, n) as:
    local s is ""
    for i in range of n:
        s is s + "a"
    local p is regex.re_compile of pat
    # Compile and VM warm-up are deliberately outside every measured window.
    regex.re_search of [p, s]
    local ms is sample of [p, s]
    # Minimum of four trials reduces scheduler/noise spikes without masking
    # super-linear work: every trial searches exactly the same size-n input.
    for trial in range of 3:
        local candidate is sample of [p, s]
        if candidate < ms:
            ms is candidate
    return ms
for row in [["boundary","(\\b|a|aa)*z"],["casefold","(?i)(a|aa)*Z"],["named","(?P<x>a|aa)*z"]]:
    # Pick a machine-appropriate starting point.  Timing floors describe the
    # runner, not the engine, so being too fast must never fail this gate.
    local start is 300
    local calibration_ms is timed of [row[1],start]
    loop while calibration_ms < 50 and start < 9600:
        start is start * 2
        calibration_ms is timed of [row[1],start]
    if calibration_ms < 50:
        print of ("calibration feature=" + row[0] + " start=" + (str of start) + " ms=" + (str of calibration_ms) + " NOTE floor not reached")
    else:
        print of ("calibration feature=" + row[0] + " start=" + (str of start) + " ms=" + (str of calibration_ms))

    local prior is 0
    local n is start
    for measurement in range of 5:
        local ms is timed of [row[1],n]
        print of ("timing feature=" + row[0] + " size=" + (str of n) + " ms=" + (str of ms))
        if prior > 0:
            local ratio is ms / prior
            local margin is 2.6 - ratio
            print of ("timing feature=" + row[0] + " size=" + (str of n) + " ratio=" + (str of ratio) + " margin=" + (str of margin))
            if ratio > 2.6:
                print of ("linear ratio " + row[0] + " FAIL")
                failures is failures + 1
            else:
                print of ("linear ratio " + row[0] + " OK")
        prior is ms
        n is n * 2
print of ("failures: " + (str of failures))
