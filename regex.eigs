        return ["anchor", "end"]
    if c == "[":
        return _parse_class of st
    if c == "\\":
        _advance of st
        local e is _advance of st
        if e == "":
            return null
        if e == "b":
            return ["boundary", 0]
        if e == "B":
            return ["boundary", 1]
        if e == "w":
            return _lower_scalar_class of [[[48, 57], [65, 90], [95, 95], [97, 122]], 0, st["icase"]]
        if e == "W":
            return _lower_scalar_class of [[[48, 57], [65, 90], [95, 95], [97, 122]], 1, st["icase"]]
        if e == "s":
            return _lower_scalar_class of [[[9, 13], [32, 32]], 0, st["icase"]]
        if e == "S":
            return _lower_scalar_class of [[[9, 13], [32, 32]], 1, st["icase"]]
        if e == "d":
            return _lower_scalar_class of [[[48, 57]], 0, st["icase"]]
        if e == "D":
            return _lower_scalar_class of [[[48, 57]], 1, st["icase"]]
