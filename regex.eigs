    if c == "":
        return null
    if c == "(":
        _advance of st
        # RE2 flags affect only the remainder of their enclosing group.
        if (_peek of st) == "?" and (_peek2 of st) == "i":
            _advance of st
            _advance of st
            if (_peek of st) == ")":
                _advance of st
                st["icase"] is 1
                return ["flag"]
            if (_peek of st) != ":":
                return null
            _advance of st
            local old_scoped_icase is st["icase"]
            st["icase"] is 1
            local scoped_inner is _parse_alt of st
            st["icase"] is old_scoped_icase
            if scoped_inner == null or (_peek of st) != ")":
                return null
            _advance of st
            return scoped_inner
        local name is ""
        if (_peek of st) == "?":
            _advance of st
            if (_peek of st) != "P":
                return null
            _advance of st
            if (_peek of st) != "<":
                return null
            _advance of st
            loop while (_peek of st) != ">":
                local nc is _peek of st
                if nc == "":
