            if (_peek of st) == "]":
                append of [ranges, [lo, lo]]
                append of [ranges, [45, 45]]
                _advance of st
                break
            local hi_scalar is _advance_class_scalar of st
            local hi is hi_scalar[0]
            if hi < 0:
                return null
            if hi < lo:
                return null
            append of [ranges, [lo, hi]]
        else:
            append of [ranges, [lo, lo]]
