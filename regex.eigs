        _unicode_property_asts[key] is _lower_scalar_class of [property[1], neg, st["icase"]]
    return _unicode_property_asts[key]

# Forward declarations via mutual recursion are fine in EigenScript
# (load order doesn't matter for function refs resolved at call time).

# ---- _parse_class: '[' '^'? (char ('-' char)?)+ ']' ----
# Encodes the body as a list of [lo, hi] code-point ranges (single chars
# become [c, c]). A leading '^' flips `neg` to 1. A trailing '-' before
# ']' is treated as a literal '-' (45) — keeps the common "[a-z-]" pattern
# parseable without forcing an escape.
define _parse_class(st) as:
    _advance of st
    local neg is 0
    if (_peek of st) == "^":
        _advance of st
        neg is 1
    local ranges is []
    loop while 1:
        local c is _peek of st
        if c == "":
            return null
        if c == "]":
            _advance of st
            break
        if c == "\\" and ((_peek2 of st) == "p" or (_peek2 of st) == "P"):
            _advance of st
            local pe is _advance of st
            local pn is 0
            if pe == "P":
                pn is 1
            local property_ranges is _parse_unicode_property_ranges of [st, pn]
            if property_ranges == null:
                return null
            for pr in property_ranges[1]:
                append of [ranges, pr]
            continue
        if c == "[":
            if (_peek2 of st) == ":":
                # POSIX class: [:name:] — expand to ranges and continue.
                _advance of st
                _advance of st
                local name is ""
                loop while 1:
                    local d is _peek of st
                    if d == "":
                        return null
                    if d == ":":
                        break
                    name is name + (_advance of st)
                _advance of st
                if (_peek of st) != "]":
                    return null
                _advance of st
                local prs is _posix_ranges of name
                if prs == null:
                    return null
                for pr in prs:
                    append of [ranges, pr]
                continue
